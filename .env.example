# Gold API Configuration
GOLD_API_KEY=your_gold_api_key_here
# Optional: multiple keys (primary first). App will only rotate on quota/rate-limit errors.
# Example: GOLD_API_KEYS=key1,key2
# GOLD_API_KEYS=

# Application Authentication (Required)
# Set these to your desired login credentials
APP_USERNAME=your_username_here
APP_PASSWORD=your_secure_password_here

# Flask Secret Key (for session security)
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=your_secret_key_here

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Daily Telegram summary (Africa/Cairo), weekdays only. Uses prices from the last poll — no extra GoldAPI call.
# DAILY_NOTIFICATION_HOUR=18
# DAILY_NOTIFICATION_MINUTE=5

# Telegram Webhook URL (for bot commands)
# Set this to your server URL where the Flask app is accessible
# Example: https://your-domain.com/telegram-webhook
WEBHOOK_URL=https://your-domain.com/telegram-webhook

# Telegram Webhook Secret (for request verification)
# Generate a secure secret and set it on your bot webhook with Telegram API
# Without this, webhook requests are not verified (less secure)
# To set: Use Telegram Bot API setWebhook with secret_token parameter
# Telegram will send X-Telegram-Bot-API-Secret-Token header to your webhook
# Example: TELEGRAM_WEBHOOK_SECRET=your_secret_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Manual PayPal withdrawal fee used by the calculator.
# Example: 0.03 = 3% manual withdrawal fee.
PAYPAL_MANUAL_WITHDRAWAL_FEE_PCT=0.03

# PayPal GBP -> USD discount applied on top of the live market rate.
# Example: 0.03135 = 3.135% below the live GBP/USD rate.
PAYPAL_CONVERSION_DISCOUNT_PCT=0.03135

# nsave withdraw-to-EGP fee used for bank / InstaPay / mobile wallet cash-outs.
# Example: 0.01 = 1% fee.
PAYPAL_NSAVE_WITHDRAW_TO_EGP_FEE_PCT=0.01

# Backward-compatible alias for older configs.
# PAYPAL_INSTA_PAY_FEE_PCT=0.01

# Optional threshold in EGP before the calculator treats the options as meaningfully different.
PAYPAL_TRANSFER_THRESHOLD_EGP=1.0
